<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- 광고(AdMob, 2026-11-29): 모든 사용자를 어린이로 다루므로 광고 SDK가 더하는 AD_ID 권한을 병합에서 뺀다.
         이 권한이 없으면 광고 ID를 못 읽는 것은 Android 13(API 33) 이상뿐이다 — 12 이하는 어린이 대상 처리에 맡긴다(Play 가족 정책 https://support.google.com/googleplay/android-developer/answer/9893335) -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove"/>
    <!-- 안드로이드 광고 서비스(관심사·측정) 권한도 뺀다 — 맞춤 광고를 쓰지 않으므로 필요 없다.
         공식 문서에서 어린이 앱에 대한 명시는 찾지 못해 보수적으로 뺀 것(2026-11-29, .omc/research/vocab-ads.md) -->
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_AD_ID" tools:node="remove"/>
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_ATTRIBUTION" tools:node="remove"/>
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_TOPICS" tools:node="remove"/>
    <!-- 매일 알림(2026-11-28 사용자 결정, flutter_local_notifications): 알림 권한(안드로이드 13+)과
         재부팅 뒤 예약을 다시 걸기 위한 부팅 완료 수신. 정확한 알람 권한(SCHEDULE_EXACT_ALARM)은 쓰지 않는다(인터넷은 광고 SDK가 넣는다 — 위 광고 주석) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <!-- 앱 이름 "Vocara"(2026-11-28 사용자 결정 — 영문 표기, "영단어"는 Play 제목·설명에만).
         바꿀 때는 lib/app_info.dart의 appTitle과 함께 바꾼다 -->
    <application
        android:label="Vocara"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- 매일 알림: 예약한 알림을 띄우고, 재부팅·앱 업데이트 뒤 예약을 다시 건다(flutter_local_notifications README) -->
        <receiver android:exported="false" android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver" />
        <receiver android:exported="false" android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>
        <!-- AdMob 앱 ID(2026-11-29). 값은 android/app/build.gradle.kts의 manifestPlaceholders —
             debug는 Google 테스트 ID, release는 실제 ID -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${admobAppId}"/>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- flutter_tts: 기기의 TTS 엔진을 찾기 위해 필요(SETUP.md) -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE"/>
        </intent>
    </queries>
</manifest>
